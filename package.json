{
  "name": "visualization-lab",
  "version": "0.12.2",
  "description": "A browser workbench for building interactive teaching visuals with JavaScript and comparing how different libraries explain the same idea.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:gallery": "node scripts/build_gallery.mjs",
    "add-lesson": "node scripts/add_lesson.mjs",
    "mirror": "node scripts/mirror.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run build && node --test 'test/unit/*.test.mjs' 'test/e2e/*.test.mjs'",
    "test:unit": "npm run build && node --test 'test/unit/*.test.mjs'",
    "test:e2e": "npm run build && node --test 'test/e2e/*.test.mjs'",
    "test:gallery": "node --test --test-concurrency=1 'test/gallery/*.test.mjs'",
    "test:all": "npm test && npm run test:gallery"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.50.0"
  }
}
